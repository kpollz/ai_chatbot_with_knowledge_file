# Copy to .env and fill in. docker-compose reads this file for every service.
#   cp .env.example .env

# ---- LLM: an OpenAI-compatible endpoint with native function calling ----
OPENAI_BASE_URL=http://your-host:1234/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=your-model-name
LLM_TEMPERATURE=0

# ---- PostgreSQL ----
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_NAME=issue_api          # the Issue API's data
AGENT_DB_NAME=agent_state  # conversation checkpoints; the checkpointer owns this schema

# ---- Service addresses (Docker network names; change for a local run) ----
ISSUE_API_URL=http://issue-api:8888
DATABASE_URI=postgresql://postgres:postgres@postgres:5432/agent_state
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/issue_api
API_HOST=0.0.0.0
API_PORT=8888

# ---- Langfuse tracing (optional) ----
# Both keys must be set for tracing to turn on; otherwise it is a no-op.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com     # EU region
# LANGFUSE_HOST=https://us.cloud.langfuse.com  # US region
