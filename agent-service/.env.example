# Issue API (the search_issues tool calls this)
ISSUE_API_URL=http://localhost:8888

# LLM (OpenAI-compatible endpoint). OPENAI_API_KEY here is only a fallback —
# each user normally sends their own key per request (see AGENT_API_KEY_HEADER).
OPENAI_BASE_URL=http://your-host:8642/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=your-model-name
LLM_TEMPERATURE=0

# Where LangGraph stores conversation checkpoints (multi-turn state).
# Sync driver URL — psycopg, NOT the +asyncpg one the Issue API uses.
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/issue_api

# Server
AGENT_HOST=0.0.0.0
AGENT_PORT=8700
AGENT_API_KEY_HEADER=x-openai-api-key

# Langfuse tracing (optional — tracing is a no-op when unset)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
