# ============================================
# Agent Configuration (app/main.py, served over AG-UI)
# ============================================

# ---- Issue API (Sub-project 2) ----
ISSUE_API_URL=http://localhost:8888

# ---- Conversation threads ----
# The checkpointer owns the schema of this database, so give it its own.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/agent_state

# ---- LLM (OpenAI-compatible endpoint, native tool calling) ----
LLM_TEMPERATURE=0
OPENAI_BASE_URL=http://your-host:1234/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=your-model-name

# ---- Langfuse Tracing (v4, optional) ----
# Both keys must be set for tracing to turn on; otherwise it is a no-op.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com     # EU region
# LANGFUSE_HOST=https://us.cloud.langfuse.com  # US region
