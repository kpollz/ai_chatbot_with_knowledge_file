# ============================================
# Agent Configuration — shared by both entrypoints
# (app/main.py over AG-UI, app/streamlit_app.py)
# ============================================

# ---- Issue API (Sub-project 2) ----
ISSUE_API_URL=http://localhost:8888

# ---- Conversation threads (AG-UI entrypoint only) ----
# The checkpointer owns the schema of this database, so give it its own.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/agent_state

# ---- LLM Configuration (OpenAI-compatible endpoint, native tool calling) ----
LLM_TEMPERATURE=0
OPENAI_BASE_URL=http://your-host:8642/v1
OPENAI_API_KEY=your-api-key-here   # sidebar key overrides this at runtime
OPENAI_MODEL=hermes-agent

# ---- Context Window (Streamlit entrypoint only) ----
CONTEXT_WINDOW_LIMIT=128000
CONTEXT_WARN_THRESHOLD=100000

# ---- Langfuse Tracing (v4) ----
# Langfuse SDK v4 reads these env vars automatically
# Get your keys from: https://cloud.langfuse.com or your self-hosted instance
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com  # EU region
# LANGFUSE_HOST=https://us.cloud.langfuse.com  # US region
# LANGFUSE_DEBUG=False  # Enable debug logging
